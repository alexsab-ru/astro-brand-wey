---
import { SITE_NAME } from '@/const';
const path = Astro.url.pathname;
---
{path === '/' ? (
<div class="flex xs:flex-col flex-nowrap items-center xs:gap-2 gap-3 xs:divide-x-0 divide-x divide-white/30 cursor-pointer" x-data="scrollTop" x-on:click="onClick">
    <img src="https://cdn.alexsab.ru/b/wey/img/logo/logo.svg" class="h-3 sm:h-4 xl:h-6" alt={SITE_NAME} loading="lazy" />
    <span class="xs:pl-0 pl-3 text-white/50 xl:text-2xl uppercase font-medium !leading-none select-none">{SITE_NAME}</span>
</div>
) : (
<a href="/" class="flex xs:flex-col flex-nowrap items-center xs:gap-2 gap-3 xs:divide-x-0 divide-x divide-black/20">
    <img src="https://cdn.alexsab.ru/b/wey/img/logo/logo.svg" class="h-3 sm:h-4 xl:h-6" alt={SITE_NAME} loading="lazy" />
    <span class="xs:pl-0 pl-3 text-white/50 xl:text-2xl uppercase font-medium !leading-none select-none">{SITE_NAME}</span>
</a>
)}
